{
  "name": "byitovaya-magiya-push-preview",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "APP_ORIGIN": "https://pwa-prototype.byitovaya-magiya.pages.dev",
